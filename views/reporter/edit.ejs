<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= published ? 'עדכון כתבה שפורסמה' : 'עריכת כתבה' %> | PRIME news</title>
  <!-- ייבוא פונטים מודרניים לעברית (Heebo & Assistant) -->
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Heebo:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
        --primary-dark: #0B1F3A;     /* כחול כהה - אמינות וסמכות */
        --accent-red: #C81D25;       /* אדום עמוק - חדשות חמות */
        --bg-color: #F3F5F7;         /* אפור בהיר - רקע מודרני */
        --card-bg: #FFFFFF;          /* לבן נקי */
        --text-main: #1A1A1A;        /* שחור פחם - טקסט ראשי */
        --text-muted: #64748b;
        --border-color: #E2E8F0;
    }

    body { 
        font-family: 'Assistant', sans-serif; 
        background-color: var(--bg-color); 
        color: var(--text-main);
        margin: 0; 
        padding: 25px; 
        direction: rtl; 
    }

    .container { 
        max-width: 850px; 
        margin: 0 auto; 
        background: var(--card-bg); 
        padding: 35px; 
        border-radius: 14px; 
        box-shadow: 0 4px 20px rgba(11, 31, 58, 0.06); 
        border-top: 5px solid var(--primary-dark);
    }

    .top-bar { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border-bottom: 2px solid var(--bg-color); 
        padding-bottom: 20px; 
        margin-bottom: 25px; 
    }

    .top-bar h1 {
        font-family: 'Heebo', sans-serif;
        margin: 0;
        font-size: 26px;
        color: var(--primary-dark);
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .top-bar h1 span {
        color: var(--accent-red);
    }

    .back-link { 
        text-decoration: none; 
        color: var(--primary-dark); 
        font-weight: 700; 
        font-family: 'Heebo', sans-serif;
        background: #f1f5f9;
        padding: 8px 16px;
        border-radius: 8px;
        transition: background 0.2s;
    }

    .back-link:hover {
        background: var(--primary-dark);
        color: white;
    }

    .status-badge-bar {
        background: #f8fafc;
        padding: 12px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 15px;
        border: 1px solid var(--border-color);
        font-weight: 600;
    }

    .notice {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    .error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    .success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    .editor-notes {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #b45309;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .editor-notes h2 {
        font-family: 'Heebo', sans-serif;
        margin-top: 0;
        font-size: 17px;
        color: #92400e;
        border-bottom: 1px solid #fcd34d;
        padding-bottom: 8px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--text-main);
        font-family: 'Heebo', sans-serif;
    }

    input[type="text"], select, textarea {
        width: 100%;
        padding: 12px 16px;
        font-size: 15px;
        font-family: 'Assistant', sans-serif;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s, background-color 0.2s;
        background-color: #fafafa;
        color: var(--text-main);
    }

    input[type="file"] {
        width: 100%;
        padding: 10px;
        font-family: 'Assistant', sans-serif;
        border: 1px dashed var(--primary-dark);
        border-radius: 8px;
        background-color: #f8fafc;
        cursor: pointer;
    }

    .image-preview-box {
        margin-top: 12px;
        background: #f8fafc;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .current-img-preview {
        max-height: 80px;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        object-fit: cover;
    }

    .delete-img-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: var(--accent-red);
        font-weight: 700;
        cursor: pointer;
    }

    input[type="text"]:focus, select:focus, textarea:focus {
        border-color: var(--primary-dark);
        background-color: #fff;
    }

    input:disabled, select:disabled, textarea:disabled {
        background-color: #e2e8f0;
        cursor: not-allowed;
        color: var(--text-muted);
    }

    textarea {
        resize: vertical;
        min-height: 250px;
        line-height: 1.7;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
        border-top: 2px solid var(--bg-color);
        padding-top: 25px;
    }

    .btn {
        padding: 13px 24px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 700;
        font-family: 'Heebo', sans-serif;
        cursor: pointer;
        border: none;
        transition: background 0.2s, transform 0.1s;
    }

    .btn-save-draft {
        background-color: #e2e8f0;
        color: var(--primary-dark);
    }
    .btn-save-draft:hover {
        background-color: #cbd5e1;
    }

    .btn-submit {
        background-color: var(--primary-dark);
        color: white;
        box-shadow: 0 4px 10px rgba(11, 31, 58, 0.2);
    }
    .btn-submit:hover {
        background-color: var(--accent-red);
    }
  </style>
</head>
<body>
  <main class="container">
    <div class="top-bar">
      <h1>PRIME <span>NEWS</span> | <%= published ? 'עדכון כתבה שפורסמה' : 'עריכת כתבה' %></h1>
      <a class="back-link" href="/reporter/articles">← חזרה לכתבות שלי</a>
    </div>

    <div class="status-badge-bar">
      סטטוס: <strong><%= published && article.status !== 'Published' ? 'פורסמה · עדכון ' + STATUS_LABELS[article.status] : STATUS_LABELS[article.status] %></strong>
    </div>

    <% if (published) { %>
      <div class="notice">הכתבה כבר פורסמה. הקוראים ממשיכים לראות את הגרסה המקורית עד שעורך יאשר את העדכון.</div>
    <% } %>

    <% if (article.status === 'Returned' && article.editorNote) { %>
      <section class="editor-notes">
        <h2>הערות העורך</h2>
        <p><%= article.editorNote %></p>
      </section>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <% if (typeof saved !== 'undefined' && saved) { %><div class="success">הטיוטה נשמרה בהצלחה</div><% } %>
    <% if (typeof locked !== 'undefined' && locked) { %><div class="notice">הכתבה נמצאת כרגע אצל העורך ולכן אי אפשר לערוך אותה.</div><% } %>

    <form id="article-form" action="/reporter/articles/<%= article._id %>/submit" method="POST" enctype="multipart/form-data"
          data-article-id="<%= article._id %>"
          data-server-saved-at="<%= article.updatedAt ? article.updatedAt.toISOString() : '' %>"
          data-locked="<%= typeof locked !== 'undefined' ? locked : false %>">
      
      <div class="form-group">
        <label for="title">כותרת הכתבה</label>
        <input id="title" name="title" type="text" maxlength="300" value="<%= article.title || '' %>" <%= (typeof locked !== 'undefined' && locked) ? 'disabled' : '' %> placeholder="הכנס כותרת...">
      </div>

      <div class="form-group">
        <label for="category">קטגוריית ערוץ (PRIME Channel)</label>
        <select id="category" name="category" <%= (typeof locked !== 'undefined' && locked) ? 'disabled' : '' %>>
          <option value="">בחרי קטגוריה</option>
          <% ['Technology', 'Sports', 'Politics', 'Economy', 'Entertainment'].forEach(cat => { %>
            <option value="<%= cat %>" <%= article.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <!-- ניהול תמונה ראשית ואפשרות מחיקה -->
      <div class="form-group">
        <label for="mainImage">העלאת תמונה ראשית מהמחשב</label>
        <input id="mainImage" name="mainImage" type="file" accept="image/*" <%= (typeof locked !== 'undefined' && locked) ? 'disabled' : '' %>>
        
        <% if (article.mainImage) { %>
          <div class="image-preview-box">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="<%= article.mainImage %>" alt="תמונה קיימת" class="current-img-preview">
              <span style="font-size: 13px; color: var(--text-muted);">תמונה נוכחית בשימוש (תוצג גם לעורך)</span>
            </div>
            <label class="delete-img-checkbox">
              <input type="checkbox" name="deleteImage" value="true">
              מחק תמונה זו
            </label>
          </div>
        <% } %>
      </div>

      <div class="form-group">
        <label for="content">תוכן הכתבה</label>
        <textarea id="content" name="content" rows="18" <%= (typeof locked !== 'undefined' && locked) ? 'disabled' : '' %> placeholder="התחל לכתוב את גוף הכתבה כאן..."><%= article.content || '' %></textarea>
      </div>

      <p id="save-status" aria-live="polite"></p>

      <% if (!(typeof locked !== 'undefined' && locked)) { %>
        <div class="form-actions">
          <button type="submit" formaction="/reporter/articles/<%= article._id %>/save" class="btn btn-save-draft">שמירת טיוטה</button>
          <button type="submit" class="btn btn-submit">שליחה לאישור עורך</button>
        </div>
      <% } %>
    </form>
  </main>

  <script src="/js/autosave.js"></script>
</body>
</html>
