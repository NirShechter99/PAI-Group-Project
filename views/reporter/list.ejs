<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>הכתבות שלי | PRIME news</title>
  <!-- ייבוא פונטים מודרניים לעברית (Heebo & Assistant) -->
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Heebo:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
        --primary-dark: #0B1F3A;     /* כחול כהה - אמינות וסמכות */
        --accent-red: #C81D25;       /* אדום עמוק - חדשות חמות */
        --bg-color: #F3F5F7;         /* אפור בהיר - רקע מודרני */
        --card-bg: #FFFFFF;          /* לבן נקי */
        --text-main: #1A1A1A;        /* שחור פחם - טקסט ראשי */
        --text-muted: #64748b;
        --border-color: #E2E8F0;
    }

    body { 
        font-family: 'Assistant', sans-serif; 
        background-color: var(--bg-color); 
        color: var(--text-main);
        margin: 0; 
        padding: 25px; 
        direction: rtl; 
    }

    .container { 
        max-width: 1100px; 
        margin: 0 auto; 
        background: var(--card-bg); 
        padding: 30px; 
        border-radius: 14px; 
        box-shadow: 0 4px 20px rgba(11, 31, 58, 0.06); 
        border-top: 5px solid var(--primary-dark);
    }

    .reporter-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border-bottom: 2px solid var(--bg-color); 
        padding-bottom: 20px; 
        margin-bottom: 25px; 
    }

    .reporter-header h1 { 
        font-family: 'Heebo', sans-serif;
        margin: 0; 
        font-size: 28px; 
        color: var(--primary-dark);
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .reporter-header h1 span {
        color: var(--accent-red);
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn { 
        background-color: var(--primary-dark);
        color: white;
        padding: 10px 18px; 
        border-radius: 8px; 
        text-decoration: none; 
        font-size: 14px; 
        cursor: pointer; 
        border: none;
        font-weight: 700;
        font-family: 'Heebo', sans-serif;
        transition: background 0.2s;
        box-shadow: 0 2px 6px rgba(11, 31, 58, 0.2);
    }

    .btn:hover { 
        background-color: var(--accent-red); 
    }

    .btn-secondary {
        background-color: #f1f5f9;
        color: var(--primary-dark);
        border: 1px solid var(--border-color);
        box-shadow: none;
    }

    .btn-secondary:hover {
        background-color: var(--primary-dark);
        color: white;
    }

    table.articles-table { 
        width: 100%; 
        border-collapse: collapse; 
        margin-top: 10px; 
    }

    th, td { 
        padding: 14px 16px; 
        border-bottom: 1px solid var(--border-color); 
        text-align: right; 
    }

    th { 
        background: #f8fafc; 
        font-weight: 700; 
        color: var(--primary-dark);
        font-family: 'Heebo', sans-serif;
        font-size: 15px;
    }

    .status { 
        padding: 5px 10px; 
        border-radius: 6px; 
        font-size: 12px; 
        font-weight: 700; 
        display: inline-block; 
        font-family: 'Heebo', sans-serif;
    }

    .status-Pending { background: #fef3c7; color: #b45309; }
    .status-Published { background: #dcfce7; color: #166534; }
    .status-Returned { background: #fee2e2; color: #991b1b; }
    .status-Draft { background: #f1f5f9; color: #475569; }

    .actions-cell { 
        display: flex; 
        gap: 15px; 
        align-items: center; 
    }

    .actions-cell a {
        color: var(--primary-dark);
        text-decoration: none;
        font-weight: 700;
        font-family: 'Heebo', sans-serif;
        font-size: 14px;
        transition: color 0.2s;
    }

    .actions-cell a:hover {
        color: var(--accent-red);
        text-decoration: underline;
    }

    form.inline { display: inline; margin: 0; }

    .link-danger {
        background: none;
        border: none;
        color: var(--accent-red);
        cursor: pointer;
        font-weight: 700;
        font-family: 'Heebo', sans-serif;
        font-size: 14px;
        padding: 0;
        text-decoration: underline;
    }

    .link-danger:hover {
        color: #991b1b;
    }

    .empty-state {
        text-align: center;
        color: var(--text-muted);
        padding: 50px 20px;
        font-size: 16px;
        font-weight: 600;
    }
  </style>
</head>
<body>
  <main class="container">
    <header class="reporter-header">
      <h1>PRIME <span>NEWS</span> | הכתבות שלי</h1>
      <div class="header-actions">
        <a class="btn btn-secondary" href="/">עמוד הבית</a>
        <a class="btn" href="/reporter/articles/new">+ כתבה חדשה</a>
      </div>
    </header>

    <% if (articles.length === 0) { %>
      <div class="empty-state">עדיין אין לך כתבות במערכת. לחץ על "+ כתבה חדשה" כדי להתחיל לכתוב.</div>
    <% } else { %>
      <table class="articles-table">
        <thead>
          <tr>
            <th>כותרת</th>
            <th>סטטוס</th>
            <th>עודכנה לאחרונה</th>
            <th>פעולות</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(a => { const pub = wasPublished(a); %>
            <tr>
              <td><strong><%= a.title || '(ללא כותרת)' %></strong></td>
              <td>
                <% if (pub && a.status !== 'Published') { %>
                  <span class="status status-Published">פורסמה</span>
                  <small style="margin-right: 6px; color: var(--text-muted);">· עדכון: <span class="status status-<%= a.status %>"><%= STATUS_LABELS[a.status] %></span></small>
                <% } else { %>
                  <span class="status status-<%= a.status %>"><%= STATUS_LABELS[a.status] %></span>
                <% } %>
              </td>
              <td><%= a.updatedAt.toLocaleString('he-IL') %></td>
              <td>
                <div class="actions-cell">
                  <a href="/reporter/articles/<%= a._id %>/edit"><%= a.status === 'Pending' ? 'צפייה' : 'עריכה' %></a>
                  <% if (['Draft', 'Returned'].includes(a.status) && !pub) { %>
                    <form action="/reporter/articles/<%= a._id %>/delete" method="POST" class="inline"
                          onsubmit="return confirm('האם אתה בטוח שברצונך למחוק את הטיוטה?')">
                      <button type="submit" class="link-danger">מחיקה</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
