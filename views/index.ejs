<%- include('partials/top', { title: 'העדכונים האחרונים' }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">THE DAILY EDIT</p>
    <h1>הסיפורים של היום<span class="accent">.</span></h1>
    <p class="lead">כל מה שחשוב לדעת, ועוד קצת מעבר.</p>
  </div><span class="edition">חדשות · מחשבה · השראה</span>
</section>
<div class="page-layout">
  <section class="feed-section" aria-label="פיד חדשות">
    <form id="feed-filters" class="filter-bar" role="search" method="GET">
      <div class="search-field"><label for="search">חיפוש בכותרות</label><input id="search" name="q" type="search"
          placeholder="איזה סיפור מחפשים?" maxlength="100"
          value="<%= typeof filters.q === 'string' ? filters.q : '' %>"></div>
      <div><label for="category">קטגוריה</label><select name="category" id="category">
          <option value="">כל הנושאים</option><% Object.entries(categories).forEach(([key,value]) => { %><option
            value="<%= key %>" <%= filters.category===key ? 'selected' : '' %>><%= value %></option><% }) %>
        </select></div>
      <div><label for="viewed">מצב קריאה</label><select name="viewed" id="viewed">
          <option value="">הכול</option>
          <option value="unread" <%= filters.viewed==='unread' ? 'selected' : '' %>>טרם קראתי</option>
          <option value="read" <%= filters.viewed==='read' ? 'selected' : '' %>>כבר קראתי</option>
        </select></div>
      <div><label for="sort">מיון</label><select name="sort" id="sort">
          <option value="latest" <%= filters.sort==='latest' ? 'selected' : '' %>>החדש ביותר</option>
          <option value="oldest" <%= filters.sort==='oldest' ? 'selected' : '' %>>הישן ביותר</option>
          <option value="popular" <%= filters.sort==='popular' ? 'selected' : '' %>>הנקרא ביותר</option>
          <option value="leastViewed" <%= filters.sort==='leastViewed' ? 'selected' : '' %>>הכי פחות נצפה</option>
        </select></div>
      <button class="button" type="submit">חיפוש</button>
    </form>
    <div class="section-title">
      <h2>על סדר היום</h2><span id="feed-count"><%= feed.total %> כתבות</span>
    </div>
    <div id="articles-container" class="news-grid">
      <% feed.articles.forEach(item => { %><%- include('partials/card', { item }) %><% }) %></div>
    <p id="feed-status" class="status-message" role="status">
      <%= feed.articles.length ? '' : 'לא נמצאו כתבות. נסו לשנות את החיפוש.' %></p>
    <div id="feed-end" class="load-more"><button id="load-more" class="button subtle"
        data-page="<%= feed.currentPage %>" data-pages="<%= feed.totalPages %>"
        <%= feed.currentPage>=feed.totalPages ? 'hidden' : '' %>>כתבות נוספות ↓</button></div>
  </section><%- include('partials/weather') %>
</div>
<script src="/js/feed.js" defer></script>
<%- include('partials/bottom') %>
