<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>בדיקת כתבה | <%= article.title %></title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; color: #333; }
    .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 15px; margin-bottom: 20px; }
    .back-link { text-decoration: none; color: #1a73e8; font-weight: bold; }
    .comparison-grid { display: grid; grid-template-columns: <%= hasPublishedVersion ? '1fr 1fr' : '1fr' %>; gap: 20px; margin-bottom: 25px; }
    .version-box { border: 1px solid #ddd; border-radius: 6px; padding: 15px; background: #fafafa; }
    .version-box.new-draft { border-color: #1a73e8; background: #f8fbff; }
    .version-box h2 { margin-top: 0; font-size: 18px; border-bottom: 1px solid #ddd; padding-bottom: 10px; }
    .meta { font-size: 14px; color: #666; margin-bottom: 10px; }
    .article-img { max-width: 100%; max-height: 250px; object-fit: cover; border-radius: 4px; margin: 10px 0; }
    .content-box { white-space: pre-wrap; line-height: 1.6; background: #fff; padding: 15px; border: 1px solid #eee; border-radius: 4px; }
    .editor-actions { border-top: 2px solid #eee; padding-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .action-card { padding: 15px; border: 1px solid #ddd; border-radius: 6px; }
    .btn { padding: 10px 18px; border: none; border-radius: 4px; font-size: 15px; font-weight: bold; cursor: pointer; color: white; }
    .btn-approve { background: #28a745; width: 100%; }
    .btn-return { background: #e0a800; color: #212529; width: 100%; margin-top: 10px; }
    textarea { width: 100%; height: 80px; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
  </style>
</head>
<body>
  <main class="container">
    <div class="top-bar">
      <h1>בדיקת כתבה: <%= article.title || '(ללא כותרת)' %></h1>
      <a class="back-link" href="/editor/articles">→ חזרה ללוח הבקרה</a>
    </div>

    <p>
      <strong>כתב:</strong> <%= article.reporter ? article.reporter.username : 'לא ידוע' %> |
      <strong>סטטוס נוכחי:</strong> <%= STATUS_LABELS[article.status] %>
    </p>

    <div class="comparison-grid">
      <% if (hasPublishedVersion) { %>
        <section class="version-box">
          <h2>גרסה מפורסמת כעת לציבור (Published)</h2>
          <div class="meta"><strong>פורסם בתאריך:</strong> <%= new Date(article.publishedVersion.publishedAt).toLocaleString('he-IL') %></div>
          <div class="meta"><strong>כותרת:</strong> <%= article.publishedVersion.title %></div>
          <div class="meta"><strong>קטגוריה:</strong> <%= article.publishedVersion.category %></div>
          <% if (article.publishedVersion.mainImage) { %>
            <img class="article-img" src="<%= article.publishedVersion.mainImage %>" alt="תמונה מפורסמת">
          <% } %>
          <div class="content-box"><%= article.publishedVersion.content %></div>
        </section>
      <% } %>

      <section class="version-box new-draft">
        <h2><%= hasPublishedVersion ? 'גרסה חדשה לאישור (Draft / Update)' : 'תוכן הכתבה לאישור' %></h2>
        <div class="meta"><strong>עודכן לאחרונה:</strong> <%= new Date(article.updatedAt).toLocaleString('he-IL') %></div>
        <div class="meta"><strong>כותרת:</strong> <%= article.title %></div>
        <div class="meta"><strong>קטגוריה:</strong> <%= article.category %></div>
        <% if (article.mainImage) { %>
          <img class="article-img" src="<%= article.mainImage %>" alt="תמונת כתבה">
        <% } %>
        <div class="content-box"><%= article.content %></div>
      </section>
    </div>

    <div class="editor-actions">
      <div class="action-card">
        <h3>אישור ופרסום הכתבה</h3>
        <p>לחיצה על אישור תפרסם את הגרסה הנוכחית לציבור ותעדכן את חותמת זמן הפרסום.</p>
        <form action="/editor/articles/<%= article._id %>/approve" method="POST">
          <button type="submit" class="btn btn-approve">✓ אשר ופרסם כתבה כעת</button>
        </form>
      </div>

      <div class="action-card">
        <h3>החזרה לכתב לתיקונים</h3>
        <form action="/editor/articles/<%= article._id %>/return" method="POST">
          <label for="editorNote"><strong>הערות העורך לכתב:</strong></label>
          <textarea id="editorNote" name="editorNote" required placeholder="פרט כאן מה על הכתב לתקן..."><%= article.editorNote %></textarea>
          <button type="submit" class="btn btn-return">↺ החזר לכתב לתיקונים</button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>