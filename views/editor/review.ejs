<%- include('../partials/top', { title: 'בדיקת כתבה' }) %>
<div class="breadcrumb"><a href="/editor/articles">מערכת העריכה</a><span>/</span><span>בדיקת כתבה</span></div>
<section class="page-heading">
  <div>
    <p class="eyebrow">שולחן העריכה</p>
    <h1><%= article.title || 'טיוטה ללא כותרת' %></h1>
    <p class="lead">מאת <%= article.reporter?.username || '—' %></p>
  </div><span class="badge <%= article.status %>"><%= STATUS_LABELS[article.status] %></span>
</section>
<div class="comparison">
  <section class="panel published-panel">
    <p class="eyebrow">מה שהקוראים רואים</p>
    <h2>הגרסה המפורסמת</h2><% if(article.publishedVersion?.publishedAt) { const p=article.publishedVersion; %><p
      class="muted">עודכן ב־<%= date(p.publishedAt) %></p><img class="review-image" src="<%= safeImage(p.mainImage) %>"
      alt="">
    <h3><%= p.title %></h3><span class="badge"><%= categories[p.category] || p.category %></span>
    <div class="preserve-lines"><%= p.content %></div><% } else { %><p class="empty-state">הכתבה טרם פורסמה.</p><% } %>
  </section>
  <section class="panel">
    <p class="eyebrow">מהדורת העבודה</p>
    <h2>התוכן שהוגש</h2>
    <form class="stack" action="/editor/articles/<%= article._id %>/save" method="POST"><input type="hidden"
        name="_csrf" value="<%= csrf %>">
      <div><label for="title">כותרת</label><input id="title" name="title" maxlength="300"
          value="<%= article.title || '' %>"></div>
      <div><label for="category">קטגוריה</label><select id="category" name="category"
          ><% Object.entries(categories).forEach(([k,v])=>{ %><option
            value="<%= k %>" <%= article.category===k?'selected':'' %>><%= v %></option><% }) %></select></div>
      <div><label for="mainImage">תמונה ראשית</label><input id="mainImage" name="mainImage"
          value="<%= article.mainImage || '' %>"></div>
      <div><label for="content">תוכן</label><textarea id="content" name="content" rows="16" maxlength="50000"
         ><%= article.content || '' %></textarea></div>
      <button class="button subtle">שמירת תיקוני העורך</button><small
        class="muted">יש לשמור לפני פרסום. שינוי כתבה שפורסמה יוצר טיוטה חדשה; הכתב מגיש אותה לאישור.</small>
    </form>
  </section>
</div>
<section class="panel decision-panel">
  <h2>החלטת מערכת</h2><% if(article.status==='Pending') { %><div class="decision-actions">
    <form action="/editor/articles/<%= article._id %>/approve" method="POST" data-confirm="לפרסם את הגרסה השמורה?">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button">אישור ופרסום ←</button></form>
    <form action="/editor/articles/<%= article._id %>/return" method="POST" class="stack"><input type="hidden"
        name="_csrf" value="<%= csrf %>"><label for="editorNote">הערות לכתב</label><textarea name="editorNote"
        id="editorNote" required maxlength="1000" rows="3" placeholder="אילו תיקונים נדרשים?"></textarea><button
        class="button subtle">החזרה לתיקונים</button></form>
  </div><% } else { %><p class="muted">אישור והחזרה לתיקונים זמינים לכתבות שממתינות לאישור.</p><% } %><div
    class="actions"><a class="text-button" href="/editor/articles/<%= article._id %>/analytics">לנתוני הצפייה ↗</a>
    <form action="/editor/articles/<%= article._id %>/delete" method="POST"
      data-confirm="למחוק את הכתבה וכל התגובות והנתונים שלה?"><input type="hidden" name="_csrf"
        value="<%= csrf %>"><button class="text-button danger">מחיקת הכתבה</button></form>
  </div>
</section>
<%- include('../partials/bottom') %>