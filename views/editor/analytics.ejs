<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>סטטיסטיקות צפייה | <%= article.title %> - PRIME news</title>
  <!-- ייבוא פונטים מודרניים לעברית (Heebo & Assistant) -->
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Heebo:wght@500;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
        --primary-dark: #0B1F3A;     /* כחול כהה - אמינות וסמכות */
        --accent-red: #C81D25;       /* אדום עמוק - חדשות חמות */
        --bg-color: #F3F5F7;         /* אפור בהיר - רקע מודרני */
        --card-bg: #FFFFFF;          /* לבן נקי */
        --text-main: #1A1A1A;        /* שחור פחם - טקסט ראשי */
        --text-muted: #64748b;
        --border-color: #E2E8F0;
    }

    body { 
        font-family: 'Assistant', sans-serif; 
        background-color: var(--bg-color); 
        color: var(--text-main);
        margin: 0; 
        padding: 25px; 
        direction: rtl; 
    }

    .container { 
        max-width: 1000px; 
        margin: 0 auto; 
        background: var(--card-bg); 
        padding: 30px; 
        border-radius: 14px; 
        box-shadow: 0 4px 20px rgba(11, 31, 58, 0.06); 
        border-top: 5px solid var(--primary-dark);
    }

    .top-bar { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border-bottom: 2px solid var(--bg-color); 
        padding-bottom: 20px; 
        margin-bottom: 25px; 
    }

    .top-bar h1 {
        font-family: 'Heebo', sans-serif;
        margin: 0;
        font-size: 26px;
        color: var(--primary-dark);
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .top-bar h1 span {
        color: var(--accent-red);
    }

    .back-link { 
        text-decoration: none; 
        color: var(--primary-dark); 
        font-weight: 700; 
        font-family: 'Heebo', sans-serif;
        background: #f1f5f9;
        padding: 8px 16px;
        border-radius: 8px;
        transition: background 0.2s;
    }

    .back-link:hover {
        background: var(--primary-dark);
        color: white;
    }

    .stats-summary { 
        display: flex; 
        gap: 20px; 
        margin-bottom: 25px; 
    }

    .stat-box { 
        background: #f8fafc; 
        border: 1px solid var(--border-color); 
        padding: 20px; 
        border-radius: 10px; 
        flex: 1; 
        text-align: center; 
    }

    .stat-box h3 { 
        margin: 0 0 8px 0; 
        font-size: 14px; 
        color: var(--text-muted); 
        font-weight: 600;
        font-family: 'Heebo', sans-serif;
    }

    .stat-box p { 
        margin: 0; 
        font-size: 24px; 
        font-weight: 800; 
        color: var(--primary-dark); 
        font-family: 'Heebo', sans-serif;
    }

    .chart-container { 
        position: relative; 
        height: 400px; 
        width: 100%; 
        background: #fff;
        padding: 15px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
    }

    .legend-note { 
        margin-top: 20px; 
        font-size: 14px; 
        color: var(--text-main); 
        background: #fef3c7; 
        border: 1px solid #fde68a;
        padding: 12px 16px; 
        border-radius: 8px; 
        font-weight: 500;
    }
  </style>
</head>
<body>
  <main class="container">
    <div class="top-bar">
      <h1>PRIME <span>NEWS</span> | סטטיסטיקות: <%= article.title || '(ללא כותרת)' %></h1>
      <a class="back-link" href="/editor/articles">← חזרה ללוח הבקרה</a>
    </div>

    <% 
      const totalViews = analyticsData.reduce((sum, item) => sum + item.views, 0);
      const publishedAt = article.publishedVersion && article.publishedVersion.publishedAt 
        ? new Date(article.publishedVersion.publishedAt) 
        : null;
    %>

    <div class="stats-summary">
      <div class="stat-box">
        <h3>סה"כ צפיות בכתבה</h3>
        <p><%= totalViews %></p>
      </div>
      <div class="stat-box">
        <h3>מועד פרסום / עדכון אחרון</h3>
        <p style="font-size: 18px;"><%= publishedAt ? publishedAt.toLocaleString('he-IL') : 'טרם פורסמה' %></p>
      </div>
      <div class="stat-box">
        <h3>חלונות זמן שנמדדו</h3>
        <p><%= analyticsData.length %></p>
      </div>
    </div>

    <div class="chart-container">
      <canvas id="impactChart"></canvas>
    </div>

    <div class="legend-note">
      <strong>מקרא גרף:</strong> נקודות <strong style="color: var(--accent-red);">אדומות בולטות</strong> על גבי הגרף מסמנות את חלון הזמן שבו בוצע פרסום או עדכון גרסה של הכתבה על ידי העורך.
    </div>
  </main>

  <script>
    const rawData = <%- JSON.stringify(analyticsData) %>;
    const publishedTimestamp = <%- JSON.stringify(publishedAt ? new Date(publishedAt.getFullYear(), publishedAt.getMonth(), publishedAt.getDate(), publishedAt.getHours(), 0, 0, 0).toISOString() : null) %>;

    const labels = rawData.map(item => new Date(item.timeWindow).toLocaleString('he-IL', {
      month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
    }));
    const views = rawData.map(item => item.views);

    // סימון נקודת פרסום העדכון בצבע אדום של המותג ובולט על הגרף
    const pointColors = rawData.map(item => {
      const itemIso = new Date(item.timeWindow).toISOString();
      return (publishedTimestamp && itemIso === publishedTimestamp) ? '#C81D25' : '#0B1F3A';
    });

    const pointRadii = rawData.map(item => {
      const itemIso = new Date(item.timeWindow).toISOString();
      return (publishedTimestamp && itemIso === publishedTimestamp) ? 9 : 4;
    });

    const ctx = document.getElementById('impactChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'מספר צפיות לפי שעה',
          data: views,
          borderColor: '#0B1F3A',
          backgroundColor: 'rgba(11, 31, 58, 0.08)',
          pointBackgroundColor: pointColors,
          pointBorderColor: pointColors,
          pointRadius: pointRadii,
          pointHoverRadius: 10,
          borderWidth: 2,
          fill: true,
          tension: 0.25
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          tooltip: {
            callbacks: {
              afterLabel: function(context) {
                const itemIso = new Date(rawData[context.dataIndex].timeWindow).toISOString();
                if (publishedTimestamp && itemIso === publishedTimestamp) {
                  return '★ בוצע פרסום / עדכון כתבה בחלון זמן זה!';
                }
                return '';
              }
            }
          }
        },
        scales: {
          y: { 
            beginAtZero: true, 
            title: { display: true, text: 'כמות צפיות', font: { family: 'Assistant', weight: 'bold' } } 
          },
          x: { 
            title: { display: true, text: 'ציר זמן (שעות)', font: { family: 'Assistant', weight: 'bold' } } 
          }
        }
      }
    });
  </script>
</body>
</html>