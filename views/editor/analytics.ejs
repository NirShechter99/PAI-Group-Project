<%- include('../partials/top', { title: 'נתוני צפייה' }) %>
<div class="breadcrumb"><a href="/editor/articles">מערכת העריכה</a><span>/</span><span>נתוני צפייה</span></div>
<section class="page-heading">
  <div>
    <p class="eyebrow">IMPACT ANALYTICS</p>
    <h1>הסיפור במספרים<span class="accent">.</span></h1>
    <p class="lead"><%= article.title %></p>
  </div><a class="button subtle" href="/editor/articles/<%= article._id %>/review">חזרה לכתבה</a>
</section>
<div class="summary-row">
  <div class="summary-tile"><span>סך
      הצפיות</span><strong><%= analyticsData.reduce((sum,d)=>sum+d.views,0).toLocaleString('he-IL') %></strong></div>
  <div class="summary-tile"><span>אירועי פרסום</span><strong><%= article.publicationHistory.length %></strong></div>
  <div class="summary-tile"><span>עדכון אחרון</span>
    <p><%= date(article.publishedVersion?.publishedAt) %></p>
  </div>
</div>
<section class="panel">
  <div class="section-title">
    <h2>צפיות לאורך זמן</h2><span>סיכום לפי שעה</span>
  </div>
  <div class="chart-container"><canvas id="impactChart" role="img"
      aria-label="גרף צפיות לפי שעה. רשימת הפרסומים וטבלת הנתונים מופיעות בהמשך."></canvas></div>
  <p class="chart-legend"><span class="line-blue">━ צפיות</span><span class="accent">┊ זמן פרסום מדויק</span></p>
  <p class="muted">הקווים האדומים ממוקמים לפי השעה והדקה המדויקות של כל פרסום. הצפיות נספרות בחלונות של שעה.</p>
  <p id="chart-status" role="status"></p>
</section>
<div class="comparison">
  <section class="panel">
    <h2>ציר הפרסומים</h2>
    <ol class="timeline"><% article.publicationHistory.forEach((p,i)=>{ %><li>
        <strong><%= i===0?'פרסום ראשון':'עדכון '+i %></strong><time><%= date(p.publishedAt) %></time><span><%= p.title %></span>
      </li><% }) %></ol><% if(!article.publicationHistory.length){ %><p>הכתבה טרם פורסמה.</p><% } %>
  </section>
  <section class="panel">
    <h2>נתוני המקור</h2>
    <details>
      <summary>הצגת טבלת הצפיות הנגישה</summary>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>תחילת השעה</th>
              <th>צפיות</th>
            </tr>
          </thead>
          <tbody><% analyticsData.forEach(d=>{ %><tr>
              <td><%= date(d.timeWindow) %></td>
              <td><%= d.views %></td>
            </tr><% }) %></tbody>
        </table>
      </div>
    </details>
  </section>
</div>
<div id="analytics-source" data-article="<%= article._id %>" hidden></div>
<script src="/js/analytics.js" defer></script>
<%- include('../partials/bottom') %>