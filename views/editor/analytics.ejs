<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>סטטיסטיקות צפייה | <%= article.title %></title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; color: #333; }
    .container { max-width: 1000px; margin: 0 auto; background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 15px; margin-bottom: 20px; }
    .back-link { text-decoration: none; color: #1a73e8; font-weight: bold; }
    .stats-summary { display: flex; gap: 20px; margin-bottom: 20px; }
    .stat-box { background: #f8fbff; border: 1px solid #d0e2ff; padding: 15px; border-radius: 6px; flex: 1; text-align: center; }
    .stat-box h3 { margin: 0 0 5px 0; font-size: 14px; color: #555; }
    .stat-box p { margin: 0; font-size: 22px; font-weight: bold; color: #1a73e8; }
    .chart-container { position: relative; height: 420px; width: 100%; }
    .legend-note { margin-top: 15px; font-size: 14px; color: #555; background: #fff3cd; padding: 10px; border-radius: 4px; }
  </style>
</head>
<body>
  <main class="container">
    <div class="top-bar">
      <h1>Impact Analytics: <%= article.title || '(ללא כותרת)' %></h1>
      <a class="back-link" href="/editor/articles">→ חזרה ללוח הבקרה</a>
    </div>

    <% 
      const totalViews = analyticsData.reduce((sum, item) => sum + item.views, 0);
      const publishedAt = article.publishedVersion && article.publishedVersion.publishedAt 
        ? new Date(article.publishedVersion.publishedAt) 
        : null;
    %>

    <div class="stats-summary">
      <div class="stat-box">
        <h3>סה"כ צפיות בכתבה</h3>
        <p><%= totalViews %></p>
      </div>
      <div class="stat-box">
        <h3>מועד פרסום / עדכון אחרון</h3>
        <p><%= publishedAt ? publishedAt.toLocaleString('he-IL') : 'טרם פורסמה' %></p>
      </div>
      <div class="stat-box">
        <h3>חלונות זמן שנמדדו</h3>
        <p><%= analyticsData.length %></p>
      </div>
    </div>

    <div class="chart-container">
      <canvas id="impactChart"></canvas>
    </div>

    <div class="legend-note">
      <strong>מקרא גרף:</strong> נקודות <strong style="color: #dc3545;">אדומות גדולות</strong> על גבי הגרף מסמנות את חלון הזמן שבו בוצע פרסום/עדכון גרסה של הכתבה על ידי העורך.
    </div>
  </main>

  <script>
    const rawData = <%- JSON.stringify(analyticsData) %>;
    const publishedTimestamp = <%- JSON.stringify(publishedAt ? new Date(publishedAt.getFullYear(), publishedAt.getMonth(), publishedAt.getDate(), publishedAt.getHours(), 0, 0, 0).toISOString() : null) %>;

    const labels = rawData.map(item => new Date(item.timeWindow).toLocaleString('he-IL', {
      month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
    }));
    const views = rawData.map(item => item.views);

    // סימון נקודת פרסום העדכון בצבע אדום ובולט על הגרף
    const pointColors = rawData.map(item => {
      const itemIso = new Date(item.timeWindow).toISOString();
      return (publishedTimestamp && itemIso === publishedTimestamp) ? '#dc3545' : '#1a73e8';
    });

    const pointRadii = rawData.map(item => {
      const itemIso = new Date(item.timeWindow).toISOString();
      return (publishedTimestamp && itemIso === publishedTimestamp) ? 9 : 4;
    });

    const ctx = document.getElementById('impactChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'מספר צפיות לפי שעה',
          data: views,
          borderColor: '#1a73e8',
          backgroundColor: 'rgba(26, 115, 232, 0.12)',
          pointBackgroundColor: pointColors,
          pointBorderColor: pointColors,
          pointRadius: pointRadii,
          pointHoverRadius: 10,
          borderWidth: 2,
          fill: true,
          tension: 0.25
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          tooltip: {
            callbacks: {
              afterLabel: function(context) {
                const itemIso = new Date(rawData[context.dataIndex].timeWindow).toISOString();
                if (publishedTimestamp && itemIso === publishedTimestamp) {
                  return '★ בוצע פרסום / עדכון כתבה בחלון זמן זה!';
                }
                return '';
              }
            }
          }
        },
        scales: {
          y: { beginAtZero: true, title: { display: true, text: 'כמות צפיות' } },
          x: { title: { display: true, text: 'ציר זמן (שעות)' } }
        }
      }
    });
  </script>
</body>
</html>