<%- include('../partials/top', { title: 'מערכת העריכה' }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">מערכת העריכה</p>
    <h1>מבט על המערכת<span class="accent">.</span></h1>
    <p class="lead">כל הסיפורים, מהטיוטה ועד הפרסום.</p>
  </div><a class="button subtle" href="/">צפייה באתר ↗</a>
</section>
<div class="summary-row">
  <div class="summary-tile"><span>ממתינות להחלטה</span><strong><%= pending %></strong></div>
  <div class="summary-tile"><span>כתבות בתצוגה הנבחרת</span><strong><%= total %></strong></div>
  <div class="summary-tile editorial-note"><span>הסיפור הבא</span>
    <p>דיוק בפרטים.<br>מקום לנקודות מבט.</p>
  </div>
</div>
<section class="panel">
  <div class="section-title">
    <h2>כל הכתבות</h2>
    <form class="actions" method="GET"><label for="status">סינון לפי סטטוס</label><select id="status" name="status">
        <option value="">כל הסטטוסים</option><% Object.entries(STATUS_LABELS).forEach(([k,v])=>{ %><option
          value="<%= k %>" <%= selectedStatus===k?'selected':'' %>><%= v %></option><% }) %>
      </select><button class="button subtle small">סינון</button></form>
  </div>
  <% if(!articles.length) { %><p class="empty-state">אין כתבות להצגה בסטטוס זה.</p><% } else { %><div
    class="table-scroll" tabindex="0" role="region" aria-label="טבלת ניהול כתבות">
    <table>
      <thead>
        <tr>
          <th>כתבה</th>
          <th>כתב</th>
          <th>סטטוס</th>
          <th>פעולות</th>
        </tr>
      </thead>
      <tbody><% articles.forEach(a=>{ %><tr>
          <td><strong><%= a.title || 'טיוטה ללא כותרת' %></strong><small><%= categories[a.category] || 'ללא קטגוריה' %>
              · <%= date(a.updatedAt) %></small></td>
          <td><%= a.reporter?.username || '—' %></td>
          <td><span
              class="badge <%= a.status %>"><%= STATUS_LABELS[a.status] %></span><% if(a.publishedVersion?.publishedAt && a.status!=='Published') { %><small>גרסה
              מאושרת באוויר</small><% } %></td>
          <td>
            <div class="actions"><a class="button subtle small" href="/editor/articles/<%= a._id %>/review">בדיקת כתבה
                ←</a><a class="text-button" href="/editor/articles/<%= a._id %>/analytics">נתוני צפייה</a></div>
          </td>
        </tr><% }) %></tbody>
    </table>
  </div><% } %>
  <nav class="pagination" aria-label="דפדוף בכתבות"><% if(page>1) { %><a class="button subtle"
      href="?page=<%= page-1 %>&status=<%= selectedStatus %>">הקודם</a><% } %><span>עמוד <%= page %> מתוך
      <%= Math.max(1,pages) %></span><% if(page<pages) { %><a class="button subtle"
      href="?page=<%= page+1 %>&status=<%= selectedStatus %>">הבא</a><% } %></nav>
</section>
<%- include('../partials/bottom') %>