<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- תגי SEO בסיסיים -->
    <title><%= article.title %> | PRIME news</title>
    <meta name="description" content="<%= article.content ? article.content.substring(0, 160) + '...' : article.title %>">
    <meta name="author" content="<%= article.reporter && article.reporter.username ? article.reporter.username : 'מערכת PRIME' %>">

    <!-- תגי Open Graph (SEO לשיתוף ברשתות חברתיות כמו WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:title" content="<%= article.title %>">
    <meta property="og:description" content="<%= article.content ? article.content.substring(0, 160) + '...' : article.title %>">
    <meta property="og:type" content="article">
    <% if (article.mainImage) { %>
        <meta property="og:image" content="<%= article.mainImage %>">
    <% } %>
    <meta property="og:site_name" content="PRIME news">

    <!-- ייבוא פונטים מודרניים לעברית (Heebo & Assistant) -->
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Heebo:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #0B1F3A;    /* כחול כהה - אמינות וסמכות */
            --accent-red: #C81D25;      /* אדום עמוק - חדשות חמות */
            --bg-color: #F3F5F7;        /* אפור בהיר - רקע מודרני */
            --card-bg: #FFFFFF;         /* לבן נקי */
            --text-main: #1A1A1A;       /* שחור פחם - טקסט ראשי */
            --text-muted: #64748b;
            --border-color: #E2E8F0;
        }

        body { 
            font-family: 'Assistant', sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main);
            margin: 0; 
            padding: 0;
            direction: rtl; 
            line-height: 1.7;
        }

        /* סרגל עליון ממותג */
        .site-header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 6px rgba(11, 31, 58, 0.04);
        }

        .brand-logo {
            font-family: 'Heebo', sans-serif;
            font-size: 24px;
            font-weight: 800;
            color: var(--primary-dark);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .brand-logo span {
            color: var(--accent-red);
        }

        .back-home-btn {
            background-color: #f1f5f9;
            color: var(--primary-dark);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            font-family: 'Heebo', sans-serif;
            transition: background 0.2s;
        }

        .back-home-btn:hover {
            background-color: var(--primary-dark);
            color: white;
        }

        /* מעטפת הכתבה */
        .article-container {
            max-width: 800px;
            margin: 40px auto;
            background: var(--card-bg);
            padding: 50px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(11, 31, 58, 0.06);
            border-top: 5px solid var(--primary-dark);
        }

        .category-tag {
            display: inline-block;
            background-color: #eef2f6;
            color: var(--primary-dark);
            font-size: 13px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 6px;
            font-family: 'Heebo', sans-serif;
            margin-bottom: 20px;
        }

        .article-title {
            font-family: 'Heebo', sans-serif;
            font-size: 38px;
            font-weight: 800;
            color: var(--primary-dark);
            margin: 0 0 20px 0;
            line-height: 1.25;
            letter-spacing: -0.5px;
        }

        .article-meta {
            font-size: 15px;
            color: var(--text-muted);
            margin-bottom: 30px;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .article-image {
            width: 100%;
            max-height: 450px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 35px;
        }

        .article-content {
            font-size: 18px;
            color: var(--text-main);
            white-space: pre-wrap;
            line-height: 1.9;
        }

        /* עיצוב אזור התגובות */
        .comments-section {
            margin-top: 50px;
            border-top: 2px solid var(--border-color);
            padding-top: 35px;
        }

        .comments-section h3 {
            font-family: 'Heebo', sans-serif;
            color: var(--primary-dark);
            font-size: 24px;
            margin-bottom: 25px;
        }

        .comment-card {
            background: #f8fafc;
            padding: 16px 20px;
            border-radius: 10px;
            margin-bottom: 15px;
            border: 1px solid var(--border-color);
        }

        .comment-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .comment-author {
            font-family: 'Heebo', sans-serif;
            color: var(--primary-dark);
            font-weight: 700;
        }

        .comment-date {
            font-size: 12px;
            color: var(--text-muted);
        }

        .comment-body {
            margin: 0;
            color: var(--text-main);
            line-height: 1.6;
            word-break: break-word;
        }

        .comment-form-box {
            margin-top: 30px;
            background: #f8fafc;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .comment-form-box h4 {
            margin-top: 0;
            font-family: 'Heebo', sans-serif;
            color: var(--primary-dark);
            font-size: 18px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            font-size: 15px;
            font-family: 'Assistant', sans-serif;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-sizing: border-box;
            outline: none;
            background: #fff;
            color: var(--text-main);
        }

        .form-control:focus {
            border-color: var(--primary-dark);
        }

        .submit-comment-btn {
            background-color: var(--primary-dark);
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            font-family: 'Heebo', sans-serif;
            font-size: 15px;
            transition: background 0.2s;
        }

        .submit-comment-btn:hover {
            background-color: var(--accent-red);
        }

        .comment-error {
            color: var(--accent-red);
            font-weight: 700;
            margin-top: 10px;
            font-size: 14px;
        }

        /* רספונסיביות למובייל */
        @media (max-width: 768px) {
            .article-container {
                margin: 15px;
                padding: 25px;
            }
            .article-title {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>

    <!-- סרגל עליון של האתר -->
    <header class="site-header">
        <a href="/" class="brand-logo">PRIME <span>NEWS</span></a>
        <a href="/" class="back-home-btn">← חזרה לעמוד הבית</a>
    </header>

    <!-- תוכן הכתבה המלא -->
    <main class="article-container">
        <% if (typeof article.category !== 'undefined' && article.category) { %>
            <span class="category-tag"><%= article.category %></span>
        <% } %>

        <h1 class="article-title"><%= article.title %></h1>
        
        <div class="article-meta">
            <span>נכתב על ידי: <strong><%= article.reporter && article.reporter.username ? article.reporter.username : (article.author || 'מערכת PRIME') %></strong></span>
            <span>פורסם בתאריך: <%= article.publishedVersion && article.publishedVersion.publishedAt ? new Date(article.publishedVersion.publishedAt).toLocaleString('he-IL') : (article.publishedAt ? new Date(article.publishedAt).toLocaleString('he-IL') : 'לא צוין') %></span>
        </div>

        <% if (typeof article.mainImage !== 'undefined' && article.mainImage) { %>
            <img class="article-image" src="<%= article.mainImage %>" alt="<%= article.title %>">
        <% } %>

        <section class="article-content">
            <!-- התוכן המלא מרונדר מהשרת לצורך SEO וקריאות מושלמת -->
            <%= article.content %>
        </section>

        <!-- אזור תגובות קוראים ומנגנון מניעת ספאם -->
        <section class="comments-section">
            <h3>תגובות קוראים</h3>

            <!-- רשימת תגובות דינמית -->
            <div id="comments-list">
                <p style="color: var(--text-muted);">טוען תגובות...</p>
            </div>

            <!-- טופס הוספת תגובה -->
            <div class="comment-form-box">
                <h4>הוסף תגובה לכתבה</h4>
                <form id="comment-form" onsubmit="submitComment(event, '<%= article._id %>')">
                    <div class="form-group">
                        <input type="text" id="authorName" class="form-control" placeholder="השם שלך (אופציונלי, לברירת מחדל: אורח)">
                    </div>
                    
                    <div class="form-group">
                        <textarea id="commentContent" class="form-control" rows="4" placeholder="כתוב את תגובתך כאן..." required></textarea>
                    </div>
                    
                    <button type="submit" class="submit-comment-btn">פרסם תגובה</button>
                    <p id="comment-error" class="comment-error"></p>
                </form>
            </div>
        </section>
    </main>

    <script>
        // טעינת תגובות בעת טעינת העמוד
        async function loadComments(articleId) {
            try {
                const response = await fetch(`/api/comments/article/${articleId}`);
                const data = await response.json();
                const list = document.getElementById('comments-list');
                
                if (response.ok && data.comments && data.comments.length > 0) {
                    list.innerHTML = data.comments.map(c => `
                        <div class="comment-card">
                            <div class="comment-header">
                                <span class="comment-author">${escapeHtml(c.authorName)}</span>
                                <span class="comment-date">${new Date(c.createdAt).toLocaleString('he-IL')}</span>
                            </div>
                            <p class="comment-body">${escapeHtml(c.content)}</p>
                        </div>
                    `).join('');
                } else {
                    list.innerHTML = '<p style="color: var(--text-muted); padding: 10px 0;">אין עדיין תגובות לכתבה זו. היו הראשונים להגיב!</p>';
                }
            } catch (err) {
                console.error('Error loading comments:', err);
                document.getElementById('comments-list').innerHTML = '<p style="color: var(--accent-red);">שגיאה בטעינת התגובות.</p>';
            }
        }

        // שליחת תגובה חדשה ב-Ajax עם תמיכה בהגבלת ספאם (429) ושליחת מזהה הכתבה בשני השמות
        async function submitComment(event, articleId) {
            event.preventDefault();
            const authorName = document.getElementById('authorName').value;
            const content = document.getElementById('commentContent').value;
            const errorEl = document.getElementById('comment-error');
            errorEl.textContent = '';

            try {
                const response = await fetch('/api/comments/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        article: articleId, 
                        articleId: articleId, 
                        authorName: authorName, 
                        content: content 
                    })
                });
                
                const data = await response.json();

                if (response.ok) {
                    document.getElementById('comment-form').reset();
                    loadComments(articleId); // טעינה מחדש של רשימת התגובות שתציג אותה מיד
                } else {
                    errorEl.textContent = data.message || 'שגיאה בשליחת התגובה';
                }
            } catch (err) {
                console.error('Error submitting comment:', err);
                errorEl.textContent = 'שגיאת תקשורת מול השרת';
            }
        }

        // פונקציית אבטחה למניעת XSS בטקסט המוצג
        function escapeHtml(text) {
            if (!text) return '';
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }

        // הפעלת טעינת התגובות בעת פתיחת הכתבה
        loadComments('<%= article._id %>');
    </script>
</body>
</html>